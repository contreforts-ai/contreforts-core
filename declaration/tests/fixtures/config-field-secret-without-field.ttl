# SYNTHETIC, not a real connector. Exercises D15's rule 2
# (contreforts-core#16, Part 3, lint::config_field::check_secret_without_config_field)
# as narrowed -- see that module's own doc comment, and meta_shapes.ttl's
# header note, for the contradiction in the issue's literal wording this
# narrowing resolves. Once a node shape uses contreforts:configField on at
# least one of its own property shapes, every contreforts:secret true
# property shape on that SAME node shape must carry contreforts:configField
# too. This file's `apiUrl` opts the node shape in; `apiToken` is secret
# and, deliberately, carries no contreforts:configField -- the one thing
# wrong with this file.
@prefix sh:           <http://www.w3.org/ns/shacl#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix contreforts:  <https://contreforts.ds-labs.org/ontologies/declaration#> .
@prefix cftest:       <https://contreforts.ds-labs.org/ontologies/config-field-test#> .

cftest:ConfigFieldSecretShape a sh:NodeShape ;
    sh:targetClass cftest:ConfigFieldSecretConnector ;
    contreforts:category "test-only" ;
    sh:property [
        sh:path cftest:apiUrl ;
        sh:name "API URL" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        contreforts:configField "url" ;
    ] ;
    sh:property [
        sh:path cftest:apiToken ;
        sh:name "API token" ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        contreforts:secret true ;
    ] .
